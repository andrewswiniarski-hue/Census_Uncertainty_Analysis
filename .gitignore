# Environment & secrets
.venv/
.env

# Data (regenerate via scripts — never commit raw data)
# The * + ! pattern ignores all contents but keeps the .gitkeep placeholders,
# so the folder structure survives a fresh clone.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python cruft
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db

# Office lock files (created while a .pptx/.docx is open — never data)
~$*

# Product scope tool (tools/product_scope.py)
# The report and the API catalog cache are regenerated on every run; the review
# file is team-owned state and IS committed. The --export csv/xlsx outputs are
# script output too — regenerate on demand, don't commit.
product_report.html
scope_field_cache.json
product_review.csv
product_review.xlsx
# Diff snapshot - captures per-product state so successive runs can show
# 'since last regeneration' deltas on the Home tab. Regenerable on every run.
.product_scope_last_run.json
# Phase 3 sample cache - actual data slices for candidate products (EDA on
# API-fetched rows). Local-only because a sample is a moment-in-time slice
# against a rate-limited endpoint; if two teammates need it, each runs their
# own `python tools/product_scope.py --repo . --sample`.
scope_data_cache.json
# Phase 3 EDA diff - written by --sample --refresh, consumed by the next
# regen so the diff banner can flag data drift alongside repo drift.
.scope_last_eda_diff.json
# Phase 4 warm-cache batch summary - counts + path lists from the last
# --warm-cache run. Consumed by the cache-coverage header and Quick Look's
# 'non_api' detection so both survive a session restart.
.warm_cache_last_run.json
