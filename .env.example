# Census API key - optional, only needed for heavy --sample runs (>500 req/day/IP)
# Get one free: https://api.census.gov/data/key_signup.html
# Copy this file to .env and drop your key in. .env is gitignored per teammate.
CENSUS_API_KEY=your_key_here

# Claude API key for the dashboard's "Ask about this county" assistant (app_US_v7.py).
# Without it the assistant panel is off and the rest of the dashboard is unchanged.
ANTHROPIC_API_KEY=
# Model the assistant uses. Change it here, not in code.
ASSISTANT_MODEL=claude-haiku-5-5
# 1 shows the assistant's question box; 0 hides it and leaves the three ready-made prompts.
ASSISTANT_FREE_TEXT=1
