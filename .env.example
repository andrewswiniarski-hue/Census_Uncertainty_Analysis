# Census API key - REQUIRED for the data pulls in ingestion/ (the dashboard's
# pull_usdash.py, pull_usdash_alloc.py and pull_us_geometry.py stop without it).
# Get one free: https://api.census.gov/data/key_signup.html
# Copy this file to .env and replace the placeholder with your key. .env is gitignored.
CENSUS_API_KEY=paste_your_key_here

# Claude API key for the dashboard's "Ask about this county" assistant (us_county_explorer.py).
# Without it the assistant panel is off and the rest of the dashboard is unchanged.
ANTHROPIC_API_KEY=
# Model the assistant uses. Change it here, not in code.
ASSISTANT_MODEL=claude-haiku-5-5
# 1 shows the assistant's question box; 0 hides it and leaves the three ready-made prompts.
ASSISTANT_FREE_TEXT=1
